    {
        "id": "7c2f8697b2a59af0",
        "type": "influxdb in",
        "z": "4676ce2db9bd63d7",
        "influxdb": "58d9245a9571a86a",
        "name": "Energy Forecast InfluxDB",
        "query": "from(bucket: \"energy_data\")\n  |> range(start: -1h, stop: 6h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"energy_forecast\")\n  |> filter(fn: (r) => r[\"_field\"] == \"predicted_value\" or r[\"_field\"] == \"device_id\")\n  |> last()",
        "rawOutput": false,
        "precision": "",
        "retentionPolicy": "",
        "org": "ucv",
        "x": 390,
        "y": 780,
        "wires": [
            [
                "53ddf3d45358debb"
            ]
        ]
    },
    {
        "id": "53ddf3d45358debb",
        "type": "function",
        "z": "4676ce2db9bd63d7",
        "name": "CheckAbove400W()",
        "func": "/**\n * Flow 2: Edge AI - The Master Controller\n */\n\nif (Array.isArray(msg.payload)) {\n    const threshold = 400.0;\n    let mqttMessages = [];\n    let influxAlerts = [];\n\n    msg.payload.forEach(data => {\n        const id = data.deviceId;\n        const predictedPower = parseFloat(data.predicted_value || data._value);\n\n        if (id && !isNaN(predictedPower) && predictedPower > threshold) {\n            if (predictedPower > threshold) {\n                // ALERT: Send OFF through MQTT, OVERLOAD\n                mqttMessages.push({\n                    payload: \"OFF\",\n                    topic: `cmnd/${id}/POWER`\n                });\n\n                influxAlerts.push({\n                    payload: {\n                        alert_active: 1,\n                        device_id: id,\n                        predicted_val: predictedPower\n                    },\n                    measurement: \"system_alerts\"\n                });\n\n                node.warn(`[EDGE AI] OFF -> ${id} (${predictedPower}W) predicted`);\n            } else {\n                // SAFE STATUS\n                influxAlerts.push({\n                    payload: { alert_active: 0, device_id: id },\n                    measurement: \"system_alerts\"\n                });\n            }\n        }\n    });\n\n    node.status({ fill: \"green\", shape: \"dot\", text: \"Data processed\" });\n    return [mqttMessages.length > 0 ? mqttMessages : null, influxAlerts];\n}\n\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 780,
        "wires": [
            [
                "cf3e8869463f35aa"
            ],
            [
                "42da9f1a48d38a43",
                "967d09fad763556d"
            ]
